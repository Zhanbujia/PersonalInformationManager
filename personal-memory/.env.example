# ============================================================
# 复制成 .env 后按需修改。所有值都有默认，最小可运行只需要填模型密钥。
# ============================================================

# ---------- 基础 ----------
ENV=dev
DEBUG=false

# ---------- 数据库 ----------
# 本地开发：直接用超级用户也行，但 RLS 不会生效（见 README「三个角色」一节）。
# 想验证隔离，请用普通角色 pim_app —— docker compose 已经把角色建好了。
DATABASE_URL=postgresql://pim_app:pim_app@localhost:5432/pim

# 迁移专用（表 owner，必须是给 FORCE RLS 生效的那个角色）
MIGRATION_DATABASE_URL=postgresql://pim_owner:pim_owner@localhost:5432/pim

# 后台任务专用（领取队列任务、读任务进度）。
# **不填会退回 DATABASE_URL**，那样 worker 领不到任务、任务轮询接口会
# permission denied —— jobs 表对应用角色只开了 insert 和 id 列。
WORKER_DATABASE_URL=postgresql://pim_worker:pim_worker@localhost:5432/pim

DB_POOL_MIN=1
DB_POOL_MAX=10

# ---------- 认证 ----------
# 生产必须换掉：用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成
JWT_SECRET=dev-only-change-me-in-production
JWT_TTL_HOURS=168

# ---------- 模型 ----------
# 任何 OpenAI 兼容网关都能用。示例：DeepSeek / 通义 / Moonshot / 自建 vLLM
# LLM_PROVIDER=mock 时走本地确定性占位实现（不联网、不需要密钥），
# 可把"记录→分析→向量化→检索→问答→总结"整条链路完整跑通用于联调与测试；
# 接入真实模型时改回 openai 并填 LLM_API_KEY（及 EMBEDDING_API_KEY）。
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
FAST_MODEL=deepseek-chat
STRONG_MODEL=deepseek-chat
EXTRACT_MODEL_TIER=fast

# 向量模型：维度必须和数据库里的 vector(N) 一致，默认 1024。
# 改维度 = 重建 chunks 表 + 重算所有向量，不要随手改。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# ---------- 预算 ----------
MAX_ROUNDS=5
TURN_TOKENS=70000
MAX_TOOL_CALLS=12
RECURSION_LIMIT=12
DAILY_TOKEN_QUOTA=300000

# ---------- 检索 ----------
RETRIEVAL_K=8
RRF_K=60
LINK_SIMILARITY_THRESHOLD=0.75

# ---------- prompt 缓存 ----------
# 只有供应商要求显式标记（如 Anthropic 系）时才开。
# OpenAI 兼容网关多按前缀自动命中，开了反而可能因为不认识 cache_control 被拒。
PROMPT_CACHE_ENABLED=false

# ---------- 文件上传 ----------
# 本地存储目录；相对路径按 backend/ 解析。生产可换绝对路径或外挂卷。
FILE_STORAGE_DIR=data/files
MAX_UPLOAD_MB=25
# 单文件抽取出的文本上限，防止超大文档撑爆内存
MAX_EXTRACT_CHARS=200000

# ---------- 前端 ----------
VITE_API_BASE=/api
